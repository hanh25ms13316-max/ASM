# Copy to .env and adjust. Values here override nothing in params.yaml except
# infrastructure locations and secrets, which never belong in version control.
MLFLOW_TRACKING_URI=sqlite:///mlflow.db
MLFLOW_ARTIFACT_ROOT=./mlartifacts
DROPOUT_PARAMS_PATH=params.yaml
DROPOUT_DATA_PATH=data/raw/students.csv
ALERT_EMAIL=data-team@example.edu
